!app/blog
!app/blog/*
app/blog/__pycache__/
app/blog/*.pyc
!app/blog_posts
!app/blog_posts/*

# Clash Royale tracker source, tests, and scheduler (runtime data stays ignored)
!app/clash_royale.py
!tests/
!tests/test_clash_royale.py
!tests/test_home.py
!deploy/systemd/
!deploy/systemd/*

# Versioned portfolio content
!app/data/
!app/data/.gitignore
!app/data/portfolio.json

# The homepage's design record and the proofs that guard it (the paradox rule, the regression
# checklist): design/homepage-demo runs the code in app/static/home through three symlinks.
# Its captures (shots/), the other concepts and the proposal stay local.
!design/
!design/homepage-demo/
!design/homepage-demo/CONCEPT.md
!design/homepage-demo/INTEGRATION.md
!design/homepage-demo/index.html
!design/homepage-demo/data.js
!design/homepage-demo/package.json
!design/homepage-demo/src
!design/homepage-demo/styles.css
!design/homepage-demo/vendor
!design/homepage-demo/site
!design/homepage-demo/tools/
!design/homepage-demo/tools/*

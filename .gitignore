*
# except
!.gitignore
# github actions
!.github/
!.github/workflows/
!.github/workflows/*
# !pyproject.toml
# pyproject.toml and poetry.lock stay per machine: the server keeps its own Python env
# !poetry.lock
!README.md
!__init__.py
# app
!app/
!app/config.py
!app/extensions.py
!app/wtt.py
!app/design.py
# !tests/
# !tests/test_wtt.py
# blueprints
!app/blueprints
# blueprints admin
!app/blueprints/admin
# blueprints api
!app/blueprints/api
# blueprints public
!app/blueprints/public
# blueprints ear
!app/blueprints/ear
!app/blueprints/ear/*
# templates
!app/templates
!app/templates/*
!app/templates/ear
!app/templates/ear/*
# templates admin
!app/templates/admin/
!app/templates/admin/*
# templates zaychess
!app/templates/zaychess
!app/templates/zaychess/*
# templates sonar
!app/templates/sonar
!app/templates/sonar/*
# static
!app/static
# static css
!app/static/css
!app/static/css/*
!app/static/css/pages
!app/static/css/pages/*
# static vendor
!app/static/vendor
!app/static/vendor/glightbox
!app/static/vendor/glightbox/*
# pdf.js (Mozilla, Apache-2.0), versioned by its folder: renders the posters from their PDFs
# (static/site/pdf-figure.js). The .mjs builds are renamed .js so any nginx serves them as JavaScript.
!app/static/vendor/pdfjs-6.4.299/
!app/static/vendor/pdfjs-6.4.299/*
!app/static/vendor/pdfjs-6.4.299/standard_fonts/
!app/static/vendor/pdfjs-6.4.299/standard_fonts/*
# static js
!/app/static/js
!/app/static/js/*
# static game
!app/static/game
# static home: the homepage scene (TRIBAR). Every module in src/ is loaded at run time, so the
# directory ships whole; vendor/ ships only the versioned three.js bundle (the unminified
# three.module.js/three.core.js beside it are its local build input and stay out).
!app/static/home/
!app/static/home/package.json
!app/static/home/styles.css
!app/static/home/src/
!app/static/home/src/*.js
!app/static/home/vendor/
!app/static/home/vendor/three-r186/
!app/static/home/vendor/three-r186/three.module.min.js
# static site: the design system (tokens, themes, pieces, motion, works' renderings, its guide)
!app/static/site/
!app/static/site/*
!app/static/site/themes/
!app/static/site/themes/*.css
!app/static/site/works/
!app/static/site/works/*.css
# static images
!app/static/img
!app/static/img/*
!app/static/img/projects/*
!app/static/img/brand/*
# static sonar
!app/static/sonar
!app/static/sonar/*
!app/static/sonar/img
!app/static/sonar/img/*
# files
!app/static/files
!app/static/files/*
# zaychess
!app/static/zaychess

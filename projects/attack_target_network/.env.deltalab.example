# DeltaLab admin mode credentials
# Copy this file to:
#   projects/attack_target_network/.env.deltalab
# The real .env.deltalab file is git-ignored.

# Required
DELTA_ADMIN_USERNAME=admin
# Generate with:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('replace-with-strong-password'))"
DELTA_ADMIN_PASSWORD_HASH=pbkdf2:sha256:600000$replace-salt$replace-hash

# Required for signed session cookies (set a long random value)
DELTA_SECRET_KEY=replace-with-a-long-random-secret

# Session + cookie security
DELTA_ADMIN_SESSION_TTL_SECONDS=1800
# Set to False only for local HTTP development.
DELTA_SESSION_COOKIE_SECURE=True

# Brute-force protections
DELTA_ADMIN_RATE_LIMIT_MAX_ATTEMPTS=5
DELTA_ADMIN_RATE_LIMIT_WINDOW_SECONDS=300
DELTA_ADMIN_LOCKOUT_BASE_SECONDS=300
DELTA_ADMIN_LOCKOUT_MAX_SECONDS=3600
DELTA_ADMIN_FAILED_DELAY_SECONDS=0.35
